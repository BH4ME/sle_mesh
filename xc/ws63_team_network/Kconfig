config SLE_TEAM_WIFI_AP_ENABLE
    bool "Enable WiFi SoftAP coexistence smoke test"
    default y
    help
        Start the local WiFi SoftAP and HTTP WebUI used for runtime role
        selection while the SLE team network is running.

config SLE_TEAM_WIFI_AP_AUTO_START
    bool "Auto-start WiFi SoftAP and HTTP WebUI"
    default y
    depends on SLE_TEAM_WIFI_AP_ENABLE
    help
        Keep enabled for v4 unified firmware. The hosted/domain WebUI still
        needs the board HTTP API to be reachable for one-click deployment.

